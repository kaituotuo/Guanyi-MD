{
  "name": "guanyi-md",
  "version": "1.0.39",
  "description": "观译阅读器｜Markdown、TXT、PDF、EPUB 本地阅读与批注。",
  "main": "desktop/main.cjs",
  "author": "Guanyi Reader",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:icons": "node tools/generate-app-icons.mjs",
    "fetch:meilisearch": "node tools/fetch-meilisearch.mjs",
    "test:list-editing": "node tools/test-list-editing.mjs",
    "test:image-editing": "node tools/test-image-editing.mjs",
    "test:markdown-clipboard": "node tools/test-markdown-clipboard.mjs",
    "test:editor-matrix": "node tools/test-editor-matrix.mjs",
    "test:table-editing": "node tools/test-table-editing.mjs",
    "test:review-sidecar": "node tools/test-review-sidecar.mjs",
    "test:txt-preview": "node tools/test-txt-preview.mjs",
    "test:desktop-menu": "node tools/test-desktop-menu.mjs",
    "test:desktop-layout": "node tools/test-desktop-layout-contract.mjs",
    "test:desktop-layout-electron": "node tools/test-electron-layout.mjs",
    "test:directory-refresh": "node tools/test-directory-refresh.mjs",
    "test:directory-binary-electron": "node tools/run-electron-smoke.mjs tools/electron-directory-binary-smoke.cjs",
    "test:directory-removal-race-electron": "node tools/run-electron-smoke.mjs tools/electron-directory-removal-race-smoke.cjs",
    "test:search-navigation": "node tools/test-search-navigation.mjs",
    "test:desktop-file-open": "node tools/test-desktop-file-open.mjs",
    "test:desktop-file-actions": "node tools/test-electron-file-actions.mjs",
    "test:document-rename": "node tools/test-document-rename.mjs",
    "test:tabs-file-actions": "node tools/test-tabs-and-file-actions.mjs",
    "test:single-file-sync": "node tools/test-single-file-sync.mjs",
    "test:upgrade-persistence": "node tools/test-upgrade-persistence.mjs",
    "test:original-answer": "node tools/test-original-answer.mjs",
    "test:work-question": "node tools/test-work-question.mjs",
    "test:desktop-ai-bridge": "node tools/test-desktop-ai-bridge.mjs",
    "test:semantic-search": "node tools/test-semantic-search.mjs",
    "test:semantic-search-worker": "node tools/test-semantic-search-worker.mjs",
    "test:semantic-search-electron": "node tools/test-electron-semantic-search.mjs",
    "test:semantic-search-real-books": "node tools/test-semantic-search-real-books.mjs",
    "test:regression-catalog": "node tools/test-regression-catalog.mjs",
    "test:regression:editor": "node tools/run-regression-matrix.mjs editor",
    "test:regression:collaboration": "node tools/run-regression-matrix.mjs collaboration",
    "test:regression:directory": "node tools/run-regression-matrix.mjs directory",
    "test:regression:search": "node tools/run-regression-matrix.mjs search",
    "test:regression:recent": "node tools/run-regression-matrix.mjs recent",
    "test:regression:all": "node tools/run-regression-matrix.mjs all",
    "desktop": "electron .",
    "build:mac": "node tools/build-desktop.mjs --mac",
    "build:win": "node tools/build-desktop.mjs --win",
    "build:desktop": "node tools/build-desktop.mjs --all",
    "release:patch": "npm version patch --no-git-tag-version && npm run build:desktop",
    "test:desktop-binary-documents": "node tools/test-desktop-binary-documents.mjs",
    "test:desktop-binary-electron": "node tools/test-electron-binary-documents.mjs",
    "test:source-scroll": "node tools/run-electron-smoke.mjs tools/electron-source-scroll-smoke.cjs",
    "test:epub-reader": "node tools/run-electron-smoke.mjs tools/electron-epub-reader-smoke.cjs",
    "test:pdf-reader": "node tools/test-pdf-reader.mjs",
    "test:reader-integration": "node tools/run-electron-smoke.mjs tools/electron-reader-integration-smoke.cjs",
    "test:regression:readers": "node tools/run-regression-matrix.mjs readers",
    "test:reader-host": "node tools/test-reader-host.mjs"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "epubjs": "0.3.93",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.5.438"
  },
  "build": {
    "appId": "com.guanyi.md",
    "productName": "观译阅读器",
    "asar": true,
    "electronDownload": {
      "force": false,
      "checksums": {
        "electron-v43.4.0-darwin-arm64.zip": "827f9f182566f46846377575b51c547b9926b111637313a373b6f717462aebac",
        "electron-v43.4.0-win32-x64.zip": "ef0709cfa719739acce73de6f9b684304baf38c6454376638a70d34a7cecffe0"
      }
    },
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "vendor/**/*",
      "desktop/**/*",
      "build-resources/icon-512.png",
      "package.json",
      "!node_modules/.guanyi-packaging-check/**/*",
      "!node_modules/onnxruntime-web/**/*",
      "!node_modules/onnxruntime-node/script/**/*",
      "!node_modules/adm-zip/**/*"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**/*"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "txt"
        ],
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Editor"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF 文档",
        "description": "PDF 阅读与批注",
        "role": "Editor"
      },
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB 电子书",
        "description": "EPUB 阅读与笔记",
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build-resources/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "runtime/meilisearch/v1.53.1/mac-arm64/meilisearch",
          "to": "runtime/meilisearch/meilisearch"
        },
        {
          "from": "runtime/meilisearch/licenses",
          "to": "runtime/meilisearch/licenses"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "观译阅读器",
      "artifactName": "Guanyi-Reader-${version}-mac-arm64.${ext}",
      "backgroundColor": "#f6f4f1",
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 160,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build-resources/icon-1024.png",
      "executableName": "Guanyi-MD",
      "extraResources": [
        {
          "from": "runtime/meilisearch/v1.53.1/win-x64/meilisearch.exe",
          "to": "runtime/meilisearch/meilisearch.exe"
        },
        {
          "from": "runtime/meilisearch/licenses",
          "to": "runtime/meilisearch/licenses"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Guanyi-Reader-Setup-${version}-win-x64.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "观译阅读器",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  }
}
